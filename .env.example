# .env.example — copy to `.env` and fill in what you need. Never commit `.env`.

# dev | test | prod
APP_ENV=dev

# fake = offline deterministic model (default, no keys needed)
# dev  = free tiers (Groq / Gemini), SYNTHETIC DATA ONLY (the router enforces this)
# prod = Claude (Opus 5.5 / Sonnet 5.5 / Haiku 5.5) for the hosted demo, pilot and finals
LLM_PROFILE=fake

# Claude (prod profile). Alternatively run `ant auth login` and leave this empty.
ANTHROPIC_API_KEY=
# Server-side refusal fallback for Opus 5.5 / Sonnet 5.5 (see docs/DECISIONS.md E3)
ANTHROPIC_FALLBACKS=true

# Free tiers (dev profile)
GROQ_API_KEY=
GEMINI_API_KEY=

# Database: Postgres from `make db`. Leave unset to use the SQLite fallback file.
# DATABASE_URL=postgresql+psycopg://jisr:jisr_local_only@localhost:55432/jisr

# Ceiling on output tokens per LLM call (protects the demo budget)
LLM_MAX_OUTPUT_TOKENS=16000

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Pause between agent steps in the live demo (ms). Tests use 0.
DEMO_STEP_DELAY_MS=450

# Record model answers for offline replay (make record does this for you)
LLM_RECORD=false
# LLM_CASSETTE=replay/demo.cassette.jsonl
